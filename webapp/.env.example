# Postgres
POSTGRES_USER=taxonomy
POSTGRES_PASSWORD=taxonomy
POSTGRES_DB=taxonomy
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://taxonomy:taxonomy@postgres:5432/taxonomy

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_BUCKET=taxonomy-documents
MINIO_SECURE=false

# Qdrant (vector DB)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# MLflow (experiment tracking — service แยกจาก backend, DB คนละ database บน postgres เดิม, artifact เก็บใน MinIO)
MLFLOW_DB=mlflow
MLFLOW_BUCKET=mlflow-artifacts
MLFLOW_PORT=5001
MLFLOW_TRACKING_URI=http://mlflow:5000

# Embedding model
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_PROMPT=จงพิจารณาข้อความนี้เพื่อจัดหมวดหมู่ตามประเภทของปัญหาหรือภัยพิบัติ:
EMBED_DEVICE=

# Chunking
CHUNK_SIZE=200
CHUNK_OVERLAP=20

# UMAP grid search
UMAP_N_NEIGHBORS=5,10,15
UMAP_MIN_DIST=0.1,0.3
PROBE_BW=0.15
PROBE_GRID_SIZE=100
PROBE_NEIGHBORHOOD=5

# Clustering
CLUSTER_BW=0.15
CLUSTER_GRID_SIZE=120
CLUSTER_NEIGHBORHOOD=7
BRIDGE_WINDOW=3
BRIDGE_REL_THRESHOLD=

# LLM naming — default openai ไม่ตั้ง key ไว้ -> health check fail -> auto fallback เป็น TF-IDF
# ตั้ง LLM_BACKEND=ollama แล้วมี ollama server รันอยู่ก็ใช้ได้เลยไม่ต้องมี API key
LLM_BACKEND=openai
DSPY_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
OLLAMA_MODEL=gemma3:27b
OLLAMA_HOST=http://host.docker.internal:11434

# Backend
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost,http://localhost:3000

# Frontend
FRONTEND_PORT=3000
BACKEND_URL=http://backend:8000

# nginx
HTTP_PORT=80
