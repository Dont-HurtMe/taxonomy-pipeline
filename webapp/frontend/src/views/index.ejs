<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8" />
  <title>Taxonomy Pipeline</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="container">
    <h1>Taxonomy Pipeline</h1>

    <div class="card">
      <h3>สร้างโปรเจกต์ใหม่</h3>
      <form method="post" action="/projects">
        <input type="text" name="name" placeholder="ชื่อโปรเจกต์" required />
        <textarea name="description" placeholder="คำอธิบาย (ไม่บังคับ)" rows="2"></textarea>
        <button type="submit">สร้าง</button>
      </form>
    </div>

    <div class="card">
      <h3>โปรเจกต์ทั้งหมด</h3>
      <% if (projects.length === 0) { %>
        <p class="muted">ยังไม่มีโปรเจกต์</p>
      <% } else { %>
        <table>
          <thead><tr><th>ชื่อ</th><th>คำอธิบาย</th><th>สร้างเมื่อ</th></tr></thead>
          <tbody>
            <% projects.forEach(function (p) { %>
              <tr>
                <td><a href="/projects/<%= p.id %>"><%= p.name %></a></td>
                <td class="muted"><%= p.description %></td>
                <td class="muted"><%= new Date(p.created_at).toLocaleString() %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</body>
</html>
